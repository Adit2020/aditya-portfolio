# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Next.js build output
/.next/
/out/

# deployment output and local deployment metadata
/build/
/.vercel/

# environment files and local secrets
.env
.env.*
!.env.example
!.env.*.example

# logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# OS and editor files
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# local AI-agent tooling (not required to build or run the site)
.agents/
skills-lock.json

# certificates and local keys
*.pem
*.key
*.p12
*.pfx

# typescript
*.tsbuildinfo
next-env.d.ts
